{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"folio-reader", "main":"worker/index.ts", "compatibility_date":"2026-09-14", "compatibility_flags":["nodejs_compat"],
  "assets":{"directory":"dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
  "ai":{"binding":"AI"},
  "ratelimits":[{"name":"VOICE_LIMIT","namespace_id":"1002","simple":{"limit":12,"period":60}}],
  "vars":{"AI_MONTHLY_CHARACTERS":"100000"}
}
